# Normalise to LF in the repo regardless of platform. ruff format writes LF, and CI
# runs on windows-latest; without this, checkouts get CRLF and format checks fail on
# files that are actually fine.
* text=auto eol=lf

# PowerShell scripts keep CRLF for Windows tooling.
*.ps1 text eol=crlf

# Binary assets: never touch these.
*.png binary
*.jpg binary
*.ico binary
*.npz binary
